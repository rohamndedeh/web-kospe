generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model affiliator {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  user_id    String?   @db.VarChar(10)
  nama       String?   @db.VarChar(50)
  email      String?   @db.VarChar(50)
  hp         String?   @db.VarChar(50)
  alamat     String?   @default("-") @db.VarChar(255)
  password   String?   @db.VarChar(100)
  pass_hash  String?   @db.VarChar(10)
  level      String?   @default("1") @db.VarChar(50)
  parent     Int?      @default(0)
  is_active  Int?      @default(0)
  kode       Int?
  img        String?   @db.VarChar(100)
  ip         String?   @db.VarChar(50)
}

model agen {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(dbgenerated("'2021-01-01'")) @db.Date
  inputer    Int?
  id_kospe   String?   @db.VarChar(50)
  parent     Int?      @default(0)
  nama       String?   @db.VarChar(50)
  no_hp      String?   @db.VarChar(50)
  no_ktp     String?   @db.VarChar(50)
  email      String?   @db.VarChar(50)
  alamat     String?   @db.VarChar(250)
  id_hni     String?   @db.VarChar(50)
  target     Int?
  ket        String?   @db.VarChar(250)
  status     Int?      @default(0)
}

model agen_traffic {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  ip              String?   @db.VarChar(255)
  id_agen         String?   @db.VarChar(255)
  browser         String?   @db.VarChar(255)
  browser_version String?   @db.VarChar(255)
  platform        String?   @db.VarChar(255)
  device          String?   @db.VarChar(255)
  is_mobile       Boolean   @default(false)
  is_tablet       Boolean   @default(false)
  is_desktop      Boolean   @default(false)
  user_agent      String?   @db.Text
  url             String?   @db.Text
  method          String?   @db.VarChar(255)
  duration        Int?
  left_at         DateTime? @db.Timestamp(0)
  visit_id        String?   @unique(map: "visit_id") @db.VarChar(50)
}

